[Unit]
Description=Motion API Server
Documentation=https://github.com/cookie-may/motion
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/motion-server --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/motion

# Environment
Environment="PYTHONUNBUFFERED=1"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=motion-server

[Install]
WantedBy=default.target
