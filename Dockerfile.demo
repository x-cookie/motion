# Motion Demo Dockerfile
# https://github.com/cookie-may/motion
#
# Try motion with demo data in one command:
#   docker run --rm -it ghcr.io/cookie-may/motion:demo
#
# For a faster TUI experience, run the server in the background
# and connect from your host:
#   docker run --rm -d -p 8000:8000 ghcr.io/cookie-may/motion:demo
#   uvx --from motion-ui motion tui

FROM python:3.13-slim-bookworm

WORKDIR /app

# Copy source packages
COPY packages/ ./packages/

# Install packages from source
RUN pip install --no-cache-dir -e ./packages/motion-core -e ./packages/motion-server -e ./packages/motion-client -e ./packages/motion-ui[server]

# Copy demo scripts and entrypoint
COPY scripts/demo_data.py scripts/demo_data.json scripts/docker-demo-entrypoint.sh ./scripts/
RUN chmod +x ./scripts/docker-demo-entrypoint.sh
RUN sed -i 's/\r$//' ./scripts/docker-demo-entrypoint.sh

# Create non-root user and data directory
RUN useradd -m -u 1000 motion \
    && mkdir -p /data \
    && chown -R motion:motion /data /app

# USER root  # Temporarily root for testing

# Expose API port
EXPOSE 8000

# Environment variables
ENV MOTION_STORAGE_DATABASE_URL=sqlite:////data/tasks.db
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

ENTRYPOINT ["/bin/bash", "/app/scripts/docker-demo-entrypoint.sh"]
