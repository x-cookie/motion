# Motion Demo Dockerfile
# https://github.com/Kohei-Wada/motion
#
# Try motion with demo data in one command:
#   docker run --rm -it ghcr.io/kohei-wada/motion:demo
#
# For a faster TUI experience, run the server in the background
# and connect from your host:
#   docker run --rm -d -p 8000:8000 ghcr.io/kohei-wada/motion:demo
#   uvx --from motion-ui motion tui

FROM python:3.13-slim-bookworm

WORKDIR /app

# Install packages from PyPI
RUN pip install --no-cache-dir motion-ui[server]

# Copy demo scripts and entrypoint
COPY scripts/demo_data.py scripts/demo_data.json ./scripts/
COPY --chmod=755 scripts/docker-demo-entrypoint.sh ./scripts/

# Create non-root user and data directory
RUN useradd -m -u 1000 motion \
    && mkdir -p /data \
    && chown -R motion:motion /data /app

USER motion

# Expose API port
EXPOSE 8000

# Environment variables
ENV MOTION_STORAGE_DATABASE_URL=sqlite:////data/tasks.db
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

ENTRYPOINT ["./scripts/docker-demo-entrypoint.sh"]
